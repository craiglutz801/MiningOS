# Copy to a local .env.staging — never commit real secrets.
# This file is production-isolated by construction.

MINING_OS_ENVIRONMENT=staging
ENABLE_ACTIVE_MINES_API=true
ENABLE_ACTIVE_MINES_JOBS=true
VITE_ENABLE_ACTIVE_MINES=true
VITE_MINING_OS_ENV=staging

POSTGRES_USER=miningos_staging
POSTGRES_PASSWORD=miningos_staging
POSTGRES_DB=miningos_staging
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55432

# Staging-only database. Do NOT set this to the production Render URL.
DATABASE_URL=postgresql+psycopg://miningos_staging:miningos_staging@127.0.0.1:55432/miningos_staging

# Staging API origin for Vercel preview rewrites. Never miningos.onrender.com.
API_ORIGIN=http://127.0.0.1:8010
